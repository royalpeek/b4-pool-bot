BOT_TOKEN=your_telegram_bot_token
DATABASE_URL=postgresql://user:pass@host:5432/dbname
ADMIN_ID=your_telegram_user_id

MARKET_LINK_BASE=https://www.b4app.xyz/m
B4_API_URL=https://www.b4app.xyz/api/markets

# Loop pacing (free-tier friendly)
MARKET_POLL_SECONDS=5
NEW_MARKET_DELAY_SECONDS=30
SEND_DELAY_SECONDS=0.08
API_TIMEOUT_SECONDS=8

# V2 on-chain discovery (same mechanism as the live tracker bot)
ONCHAIN_ENABLED=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
B4_PROGRAM_ID=9XQDD38sy1qJ57DqAQvADuLRTjcYUXD48H7deyNuaehH
ONCHAIN_POLL_SECONDS=5
ONCHAIN_MARKET_ACCOUNT_SIZE=464

# Intentional notify delay (seconds after scheduled go-live).
# The live tracker notifies earliest; this bot deliberately lags (120-300 = 2-5 min).
NOTIFY_DELAY_SECONDS=180

# V2 lifecycle reminders (once each, edited into the single market message)
ENABLE_REMINDERS=true
REMINDER_12H_SECONDS=43200
REMINDER_6H_SECONDS=21600

# Graduation detection (V2 lifecycle): enabled by default. Only fires when the
# app reports the market as graduated. On-chain graduation accounts exist but
# the exact flag offset is not yet confirmed — safe to leave enabled.
GRADUATION_ENABLED=true

# Pacing between cleanup deletes/edits (rate-limit friendly)
DELETE_DELAY_SECONDS=0.2

PORT=5000
