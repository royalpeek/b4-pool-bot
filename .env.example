BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=your_telegram_user_id
DATABASE_URL=your_postgres_database_url
B4_API_URL=https://www.b4app.xyz/api/markets
MARKET_LINK_BASE=https://www.b4app.xyz/m

# Groq example. Keep these values in your host dashboard, not in GitHub.
GROQ_API_KEY=your_groq_api_key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
DAILY_SUMMARY_UTC_HOUR=9
NOTIFICATION_COOLDOWN_SECONDS=2
MARKET_POLL_SECONDS=1
PUBLIC_ALERT_DELAY_SECONDS=45
SEND_DELAY_SECONDS=0.05
BROADCAST_WORKERS=4
COVER_IMAGE_WAIT_SECONDS=8
COVER_IMAGE_RETRY_SECONDS=1
IMAGE_FOLLOWUP_WAIT_SECONDS=45
PREMIUM_GO_LIVE_REMINDER_SECONDS=120
TEMP_RESPONSE_DELETE_SECONDS=180

# Generic OpenAI-compatible alternative:
# AI_API_KEY=your_provider_api_key
# AI_BASE_URL=https://provider.example.com/v1
# AI_MODEL=provider-model-name
